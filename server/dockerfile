FROM node:24 AS base

RUN corepack enable

WORKDIR /var/www/html

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM base AS build

COPY ./ ./

COPY --from=dependencies /var/www/html/node_modules ./node_modules

RUN pnpm build

RUN pnpm prune --prod

FROM gcr.io/distroless/nodejs24-debian13 AS deploy

WORKDIR /var/www/html

ENV NODE_ENV=production

USER 1000

COPY --chown=1000:1000 --from=build /var/www/html/dist ./dist
COPY --chown=1000:1000 --from=build /var/www/html/node_modules ./node_modules

CMD ["dist/infra/http/main.js"]
