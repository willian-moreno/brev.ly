{
  "name": "brev.ly",
  "version": "1.0.0",
  "description": "Desafio prático Pós Full Stack com IA da Rocketseat",
  "main": "src/infra/http/main.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env src/infra/http/main.ts",
    "dev:test": "tsx watch --env-file .env.test src/infra/http/main.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:test": "dotenv -e .env.test -- drizzle-kit studio",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "pretest": "npm run db:migrate:test",
    "pretest:watch": "npm run db:migrate:test",
    "build": "tsup-node"
  },
  "license": "MIT",
  "author": "Willian Moreno (willianam.dev@gmail.com)",
  "keywords": [],
  "homepage": "https://github.com/willian-moreno/brev.ly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willian-moreno/brev.ly.git"
  },
  "bugs": {
    "url": "https://github.com/willian-moreno/brev.ly/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/lib-storage": "^3.1092.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "csv-stringify": "^6.8.1",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}